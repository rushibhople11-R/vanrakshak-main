# ========================================================
# VanRakshak Prototype Configuration
# Note: For hackathon demo, all credentials shown are test placeholders
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Prototype Demo Setting
DEMO_MODE=true
ENABLE_SIMULATION=true

# Database Storage
DATABASE_PATH=./data/vanrakshak.db

# Edge-AI Model Inference Defaults
DEFAULT_MODEL_VERSION=vanrakshak-tinyml-v1.4
CHAINSAW_CONFIDENCE_THRESHOLD=0.85
MULTI_WINDOW_CONFIRMATION_COUNT=3

# LoRa Wireless Specs (Compliant with India WPC GSR 564(E) 865-867 MHz)
LORA_REGION=IN865
LORA_FREQUENCY_MHZ=865.0625
LORA_BANDWIDTH_KHZ=125
LORA_SPREADING_FACTOR=7

# Planned Hardware Ingestion Credentials (Placeholder for future test nodes)
INGESTION_API_KEY=vr_dev_test_device_key_in865
